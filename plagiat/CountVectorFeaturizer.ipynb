    "import os\n",
    "import numpy as np\n",
    "from collections import Counter\n",
    "from typing import List\n",
    "#import import_ipynb\n",
    "#from Tokenizer import Tokenizer\n",
    "from sklearn.feature_extraction.text import CountVectorizer"
   ]
  },
  {
   "cell_type": "code",
